      }
    },
    "A permanent change occurred, but completion could not be verified. Check History; this change cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A permanent change occurred, but completion could not be verified. Check History; this change cannot be undone."
